---
/**
 * Formulario de contacto. POST a /api/lead y el servidor redirige a
 * WhatsApp (303). Funciona sin JavaScript en el cliente.
 */
interface Props {
  propiedadId?: string;
  origen?: 'ficha' | 'contacto';
}

const { propiedadId, origen = 'ficha' } = Astro.props;

const conError = Astro.url.searchParams.get('error') === 'datos';
const enviado = Astro.url.searchParams.get('enviado') === '1';
---

<form method="post" action="/api/lead" class="space-y-4">
  {
    conError && (
      <p class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">
        Revisa tu nombre y teléfono; no pudimos procesar los datos.
      </p>
    )
  }
  {
    enviado && (
      <p class="rounded-lg bg-morado-100 px-4 py-3 text-sm" role="status">
        Recibimos tu mensaje. Un asesor te contactará pronto.
      </p>
    )
  }

  {propiedadId && <input type="hidden" name="propiedad_id" value={propiedadId} />}
  <input type="hidden" name="origen" value={origen} />

  <!-- Honeypot: oculto para humanos, irresistible para bots -->
  <div class="campo-alterno" aria-hidden="true">
    <label for="sitio_web">No llenes este campo</label>
    <input type="text" id="sitio_web" name="sitio_web" tabindex="-1" autocomplete="off" />
  </div>

  <div>
    <label for="lead-nombre" class="mb-1 block text-sm font-medium">Tu nombre</label>
    <input type="text" id="lead-nombre" name="nombre" required minlength="2" maxlength="120" autocomplete="name" class="campo-input" />
  </div>

  <div>
    <label for="lead-telefono" class="mb-1 block text-sm font-medium">Tu teléfono</label>
    <input
      type="tel"
      id="lead-telefono"
      name="telefono"
      required
      pattern="[0-9+\s().\-]{7,20}"
      autocomplete="tel"
      inputmode="tel"
      class="campo-input"
    />
  </div>

  <div>
    <label for="lead-email" class="mb-1 block text-sm font-medium">Tu correo <span class="font-normal text-morado-950/50">(opcional)</span></label>
    <input type="email" id="lead-email" name="email" autocomplete="email" class="campo-input" />
  </div>

  <div>
    <label for="lead-mensaje" class="mb-1 block text-sm font-medium">¿Qué te gustaría saber?</label>
    <textarea id="lead-mensaje" name="mensaje" rows="4" maxlength="1000" class="campo-input"></textarea>
  </div>

  <button type="submit" class="boton-oscuro w-full">Hablar con el asesor</button>
  <p class="text-xs text-morado-950/50">Al enviar se abre WhatsApp con el asesor de esta propiedad.</p>
</form>
