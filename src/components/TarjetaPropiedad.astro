---
import type { Propiedad } from '../lib/types';
import { assetUrl, PRESETS } from '../lib/images';
import { formatoPrecio, etiqueta } from '../lib/format';
import Icono from './Icono.astro';

interface Props {
  propiedad: Propiedad;
  /** Las tarjetas sobre el fold cargan eager */
  prioridad?: boolean;
}

const { propiedad: p, prioridad = false } = Astro.props;

const ubicacion = [p.zona && etiqueta(p.zona), p.ciudad && etiqueta(p.ciudad)].filter(Boolean).join(', ');

const detalles: { icono: string; texto: string; etiqueta: string }[] = [];
if (p.recamaras) detalles.push({ icono: 'cama', texto: `${p.recamaras}`, etiqueta: `${p.recamaras} recámaras` });
if (p.banos) detalles.push({ icono: 'bano', texto: `${p.banos}`, etiqueta: `${p.banos} baños` });
if (p.estacionamientos)
  detalles.push({ icono: 'auto', texto: `${p.estacionamientos}`, etiqueta: `${p.estacionamientos} estacionamientos` });
if (p.m2_construccion)
  detalles.push({ icono: 'area', texto: `${p.m2_construccion} m²`, etiqueta: `${p.m2_construccion} m² de construcción` });
else if (p.m2_terreno)
  detalles.push({ icono: 'terreno', texto: `${p.m2_terreno} m²`, etiqueta: `${p.m2_terreno} m² de terreno` });
---

<article
  class="group relative overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-morado-950/5 transition-shadow hover:shadow-lg"
>
  <div class="relative">
    {
      p.imagen_principal ? (
        <img
          src={assetUrl(p.imagen_principal, 'thumb')}
          alt=""
          width={PRESETS.thumb.width}
          height={PRESETS.thumb.height}
          loading={prioridad ? 'eager' : 'lazy'}
          decoding="async"
          class="aspect-[3/2] w-full bg-morado-100 object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="aspect-[3/2] w-full bg-morado-100" />
      )
    }
    <span
      class="absolute top-3 left-3 rounded-full bg-morado-950/80 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm"
    >
      {p.operacion === 'venta' ? 'En venta' : 'En renta'}{p.estatus === 'apartada' ? ' · Apartada' : ''}
    </span>
  </div>

  <div class="p-5">
    <p class="text-2xl font-semibold tracking-tight">{formatoPrecio(p.precio, p.moneda, p.operacion)}</p>
    <h3 class="mt-1 font-sans text-sm font-normal text-morado-950/70">
      <a href={`/propiedades/${p.slug}`} class="no-underline after:absolute after:inset-0 after:content-['']">
        {ubicacion || p.titulo}
      </a>
    </h3>
    {
      detalles.length > 0 && (
        <ul class="mt-3 flex list-none flex-wrap items-center gap-x-4 gap-y-1.5 p-0 text-sm text-morado-950/60">
          {detalles.map((d) => (
            <li class="flex items-center gap-1.5">
              <Icono nombre={d.icono} clase="h-4 w-4 text-morado-500" />
              <span aria-hidden="true">{d.texto}</span>
              <span class="sr-only">{d.etiqueta}</span>
            </li>
          ))}
        </ul>
      )
    }
    <p class="mt-4 text-sm font-medium text-morado-700 transition-colors group-hover:text-morado-950">
      Ver propiedad <span aria-hidden="true">→</span>
    </p>
  </div>
</article>
