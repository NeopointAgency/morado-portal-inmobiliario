---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Página no encontrada | Morado Bienes Raíces">
  <div class="mx-auto max-w-7xl px-4 py-24 text-center sm:px-6">
    <p class="font-display text-7xl text-morado-300">404</p>
    <h1 class="mt-4 text-3xl sm:text-4xl">No encontramos esa página</h1>
    <p class="mx-auto mt-3 max-w-md text-morado-950/70">
      Puede que la propiedad ya no esté publicada o que el enlace haya cambiado.
    </p>
    <p class="mt-8">
      <a class="boton-oscuro" href="/propiedades">Ver propiedades disponibles</a>
    </p>
  </div>
</Layout>
