---
import Layout from '../../layouts/Layout.astro';
import TarjetaPropiedad from '../../components/TarjetaPropiedad.astro';
import { asesoresActivos, propiedadesDeAsesor } from '../../lib/queries';
import { assetUrl } from '../../lib/images';
import { slugify } from '../../lib/format';
import { whatsappUrl } from '../../lib/whatsapp';
import type { Propiedad } from '../../lib/types';

export const prerender = false;

// Los asesores no tienen campo slug en Directus: el slug se deriva del
// nombre. Con un equipo de ~10 personas, resolverlo en memoria es barato.
const { slug } = Astro.params;

const asesores = await asesoresActivos().catch((e) => {
  console.error('[asesor] Error al consultar Directus', e);
  return [];
});

const asesor = asesores.find((a) => slugify(a.nombre) === slug);

if (!asesor) {
  return Astro.rewrite('/404');
}

let propiedades: Propiedad[] = [];
try {
  propiedades = await propiedadesDeAsesor(asesor.id);
} catch (error) {
  console.error('[asesor] Error al cargar propiedades', error);
}

const sitio = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: asesor.nombre,
  ...(asesor.puesto ? { jobTitle: asesor.puesto } : {}),
  ...(asesor.telefono ? { telephone: asesor.telefono } : {}),
  ...(asesor.email ? { email: asesor.email } : {}),
  ...(asesor.foto ? { image: assetUrl(asesor.foto, 'card') } : {}),
  url: new URL(`/asesores/${slug}`, sitio).href,
  worksFor: { '@type': 'RealEstateAgent', name: 'Morado Bienes Raíces' },
};
---

<Layout
  titulo={`${asesor.nombre} | Morado Bienes Raíces`}
  descripcion={`${asesor.nombre}${asesor.puesto ? `, ${asesor.puesto}` : ''} en Morado Bienes Raíces. Conoce sus propiedades y contáctale directo por WhatsApp.`}
  ogImagen={asesor.foto ? assetUrl(asesor.foto, 'card') : undefined}
  ogTipo="profile"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div class="contenedor seccion">
    <nav aria-label="Ruta de navegación" style="font-size: 0.9rem; margin-bottom: 1rem;">
      <a href="/asesores">← Nuestro equipo</a>
    </nav>

    <header style="display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap; margin-bottom: 2rem;">
      {asesor.foto && (
        <img
          src={assetUrl(asesor.foto, 'thumb')}
          alt={`Fotografía de ${asesor.nombre}`}
          width="112"
          height="112"
          style="border-radius: 50%; object-fit: cover; width: 7rem; height: 7rem;"
        />
      )}
      <div>
        <h1 style="margin: 0;">{asesor.nombre}</h1>
        {asesor.puesto && <p style="margin: 0.25rem 0; color: var(--tinta-suave);">{asesor.puesto}</p>}
        {asesor.bio && <p style="margin: 0.5rem 0; max-width: 45rem;">{asesor.bio}</p>}
        <p style="margin-top: 0.75rem;">
          <a class="boton" href={whatsappUrl(asesor.whatsapp)}>Enviar WhatsApp</a>
          {asesor.telefono && (
            <a class="boton boton-secundario" href={`tel:${asesor.telefono.replace(/\s/g, '')}`} style="margin-left: 0.5rem;">
              Llamar
            </a>
          )}
        </p>
      </div>
    </header>

    <section aria-labelledby="titulo-propiedades">
      <h2 id="titulo-propiedades">Propiedades de {asesor.nombre.split(' ')[0]}</h2>
      {propiedades.length === 0 && <p class="aviso">Por ahora no tiene propiedades publicadas.</p>}
      <ul class="cuadricula-propiedades">
        {propiedades.map((p) => (
          <li>
            <TarjetaPropiedad propiedad={p} />
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
