---
import Layout from '../../layouts/Layout.astro';
import TarjetaPropiedad from '../../components/TarjetaPropiedad.astro';
import { asesoresActivos, propiedadesDeAsesor } from '../../lib/queries';
import { assetUrl } from '../../lib/images';
import { slugify } from '../../lib/format';
import { whatsappUrl } from '../../lib/whatsapp';
import type { Propiedad } from '../../lib/types';

export const prerender = false;

// Los asesores no tienen campo slug en Directus: el slug se deriva del
// nombre. Con un equipo de ~10 personas, resolverlo en memoria es barato.
const { slug } = Astro.params;

const asesores = await asesoresActivos().catch((e) => {
  console.error('[asesor] Error al consultar Directus', e);
  return [];
});

const asesor = asesores.find((a) => slugify(a.nombre) === slug);

if (!asesor) {
  return Astro.rewrite('/404');
}

let propiedades: Propiedad[] = [];
try {
  propiedades = await propiedadesDeAsesor(asesor.id);
} catch (error) {
  console.error('[asesor] Error al cargar propiedades', error);
}

const sitio = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: asesor.nombre,
  ...(asesor.puesto ? { jobTitle: asesor.puesto } : {}),
  ...(asesor.telefono ? { telephone: asesor.telefono } : {}),
  ...(asesor.email ? { email: asesor.email } : {}),
  ...(asesor.foto ? { image: assetUrl(asesor.foto, 'card') } : {}),
  url: new URL(`/asesores/${slug}`, sitio).href,
  worksFor: { '@type': 'RealEstateAgent', name: 'Morado Bienes Raíces' },
};
---

<Layout
  titulo={`${asesor.nombre} | Morado Bienes Raíces`}
  descripcion={`${asesor.nombre}${asesor.puesto ? `, ${asesor.puesto}` : ''} en Morado Bienes Raíces. Conoce sus propiedades y contáctale directo por WhatsApp.`}
  ogImagen={asesor.foto ? assetUrl(asesor.foto, 'card') : undefined}
  ogTipo="profile"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div class="bg-morado-950 text-white">
    <div class="mx-auto max-w-7xl px-4 pt-8 pb-12 sm:px-6">
      <nav aria-label="Ruta de navegación" class="mb-6 text-sm">
        <a href="/asesores" class="text-white/70 no-underline hover:text-white hover:underline">← Nuestro equipo</a>
      </nav>
      <div class="flex flex-wrap items-center gap-6">
        {
          asesor.foto && (
            <img
              src={assetUrl(asesor.foto, 'thumb')}
              alt={`Fotografía de ${asesor.nombre}`}
              width="112"
              height="112"
              class="h-28 w-28 rounded-full border-2 border-white/20 object-cover"
            />
          )
        }
        <div>
          <h1 class="text-3xl sm:text-4xl">{asesor.nombre}</h1>
          {asesor.puesto && <p class="mt-1 text-white/70">{asesor.puesto}</p>}
          {asesor.bio && <p class="mt-3 max-w-xl text-white/80">{asesor.bio}</p>}
          <p class="mt-5 flex flex-wrap gap-3">
            <a class="boton-claro" href={whatsappUrl(asesor.whatsapp)}>Enviar WhatsApp</a>
            {
              asesor.telefono && (
                <a
                  class="inline-flex items-center gap-2 rounded-full border border-white/40 px-6 py-3 font-medium text-white no-underline transition-colors hover:bg-white/10"
                  href={`tel:${asesor.telefono.replace(/\s/g, '')}`}
                >
                  Llamar
                </a>
              )
            }
          </p>
        </div>
      </div>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6" aria-labelledby="titulo-propiedades">
    <h2 id="titulo-propiedades" class="text-2xl sm:text-3xl">Propiedades de {asesor.nombre.split(' ')[0]}</h2>
    {
      propiedades.length === 0 && (
        <p class="mt-6 rounded-xl bg-morado-100 p-6 text-morado-950/80">Por ahora no tiene propiedades publicadas.</p>
      )
    }
    <ul class="mt-6 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        propiedades.map((p) => (
          <li>
            <TarjetaPropiedad propiedad={p} />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
