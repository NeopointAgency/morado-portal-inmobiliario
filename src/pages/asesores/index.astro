---
import Layout from '../../layouts/Layout.astro';
import { asesoresActivos } from '../../lib/queries';
import { assetUrl } from '../../lib/images';
import { slugify } from '../../lib/format';
import type { Asesor } from '../../lib/types';

export const prerender = false;

let asesores: Asesor[] = [];
let errorCarga = false;
try {
  asesores = await asesoresActivos();
} catch (error) {
  console.error('[asesores] Error al consultar Directus', error);
  errorCarga = true;
}
---

<Layout
  titulo="Nuestro equipo | Morado Bienes Raíces"
  descripcion="Conoce a los asesores inmobiliarios de Morado Bienes Raíces en Celaya. Atención directa y personal por WhatsApp."
>
  <div class="bg-morado-950 text-white">
    <div class="mx-auto max-w-7xl px-4 pt-10 pb-12 sm:px-6">
      <h1 class="text-4xl sm:text-5xl">Nuestro equipo</h1>
      <p class="mt-2 max-w-xl text-white/70">
        Asesores certificados CONOCER-SEP que te acompañan de principio a fin.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    {
      errorCarga && (
        <p class="rounded-xl bg-morado-100 p-6 text-morado-950/80" role="alert">
          No pudimos cargar al equipo en este momento. Intenta de nuevo en unos minutos.
        </p>
      )
    }

    {!errorCarga && asesores.length === 0 && (
      <p class="rounded-xl bg-morado-100 p-6 text-morado-950/80">Muy pronto conocerás aquí a nuestro equipo.</p>
    )}

    <ul class="grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {
        asesores.map((a) => (
          <li>
            <a href={`/asesores/${slugify(a.nombre)}`} class="group block no-underline">
              {a.foto ? (
                <img
                  src={assetUrl(a.foto, 'galeria')}
                  alt={`Fotografía de ${a.nombre}`}
                  width="253"
                  height="337"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[3/4] w-full rounded-xl bg-morado-100 object-cover object-top"
                />
              ) : (
                <span class="flex aspect-[3/4] w-full items-center justify-center rounded-xl bg-morado-100 font-display text-5xl text-morado-500">
                  {a.nombre.charAt(0)}
                </span>
              )}
              <span class="mt-3 block text-lg font-medium group-hover:underline">{a.nombre}</span>
              {a.puesto && <span class="block text-sm text-morado-950/60">{a.puesto}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
