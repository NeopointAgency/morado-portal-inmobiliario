---
import Layout from '../layouts/Layout.astro';
import TarjetaPropiedad from '../components/TarjetaPropiedad.astro';
import { configuracionSitio, propiedadesDestacadas, propiedadesParaHero, asesoresActivos } from '../lib/queries';
import { assetUrl } from '../lib/images';
import { slugify } from '../lib/format';
import type { Asesor, Propiedad } from '../lib/types';

export const prerender = false;

const config = await configuracionSitio();

let destacadas: Propiedad[] = [];
let imagenesHero: Awaited<ReturnType<typeof propiedadesParaHero>> = [];
let asesores: Asesor[] = [];
try {
  [destacadas, imagenesHero, asesores] = await Promise.all([
    propiedadesDestacadas(config),
    propiedadesParaHero(),
    asesoresActivos(),
  ]);
} catch (error) {
  console.error('[home] Error al cargar datos', error);
}

const sitio = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;

const tituloHero = config?.hero_titular ?? 'Encontrar casa emociona. Comprarla bien, tranquiliza.';
const subtituloHero =
  config?.hero_subtitulo ?? 'Venta y renta de propiedades en regla y sin letras chicas — Celaya, Querétaro y SMA.';
const ctaHero = config?.hero_cta_texto ?? 'Agendar asesoría';

// Dos filas para el marquee: si hay pocas propiedades se repiten para
// que el carril nunca se vea vacío.
function repetirHasta<T>(arr: T[], min: number): T[] {
  if (arr.length === 0) return [];
  const salida = [...arr];
  while (salida.length < min) salida.push(...arr);
  return salida.slice(0, Math.max(min, arr.length));
}
const filaSuperior = repetirHasta(imagenesHero.filter((_, i) => i % 2 === 0), 6);
const filaInferior = repetirHasta(imagenesHero.filter((_, i) => i % 2 === 1), 6);

const ciudades = [
  {
    valor: 'celaya',
    nombre: 'Celaya',
    lema: 'Explorar hogares seguros',
    imagen: '/images/ciudades/celaya.jpg',
  },
  {
    valor: 'san_miguel_de_allende',
    nombre: 'San Miguel de Allende',
    lema: 'Explorar hogares mágicos',
    imagen: '/images/ciudades/sanmigueldeallende.jpg',
  },
  {
    valor: 'queretaro',
    nombre: 'Querétaro',
    lema: 'Explorar hogares funcionales',
    imagen: '/images/ciudades/queretaro.jpg',
  },
];

// Placeholder editable hasta que existan testimonios reales en el CMS
const testimonios = [
  {
    texto: 'Compramos nuestra primera casa y nos explicaron cada papel antes de firmar. Cero sorpresas.',
    autor: 'Fernanda G., Celaya',
  },
  {
    texto: 'El precio publicado fue el precio real. Se agradece no perder el tiempo.',
    autor: 'Ricardo M., Querétaro',
  },
  {
    texto: 'Nos acompañaron con el crédito INFONAVIT de principio a fin. Muy recomendados.',
    autor: 'Sofía y Luis, Celaya',
  },
  {
    texto: 'Vendí mi casa con ellos y me tuvieron al tanto en cada paso. Nada de perseguir al asesor.',
    autor: 'Gabriela R., Celaya',
  },
  {
    texto: 'La propiedad ya traía el expediente revisado. El notario no encontró un solo pendiente.',
    autor: 'Arturo V., San Miguel de Allende',
  },
  {
    texto: 'Rentamos un local para el negocio y el contrato fue claro desde el día uno.',
    autor: 'Paola T., Celaya',
  },
  {
    texto: 'Me atendieron por WhatsApp un domingo y el lunes ya estábamos visitando casas.',
    autor: 'Jorge C., Villagrán',
  },
  {
    texto: 'Nos ayudaron a no comprar una casa con problema de escrituras. Eso no tiene precio.',
    autor: 'Mariana y Diego, Querétaro',
  },
  {
    texto: 'Todo el proceso en regla y sin letras chicas, tal como lo prometen.',
    autor: 'Luis Enrique P., Celaya',
  },
];

const pasosMetodo = [
  {
    titulo: 'Papeles',
    texto: 'Revisamos escrituras y estado legal. Si algo no cuadra, no se publica.',
  },
  {
    titulo: 'Crédito',
    texto: 'Confirmamos si de verdad acepta INFONAVIT o crédito bancario — no se dice que sí por decir.',
  },
  {
    titulo: 'Precio y datos reales',
    texto: 'El precio publicado es el precio real. Metros, recámaras y zona, verificados.',
  },
];

// JSON-LD RealEstateAgent para la organización
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: 'Morado Bienes Raíces',
  url: sitio,
  areaServed: 'Celaya, Guanajuato, México',
  ...(config?.telefono_general ? { telephone: config.telefono_general } : {}),
  ...(config?.email_contacto ? { email: config.email_contacto } : {}),
  ...(config?.logo ? { logo: assetUrl(config.logo, 'thumb') } : {}),
};
---

<Layout
  titulo="Morado Bienes Raíces | Casas y propiedades en venta y renta en Celaya"
  descripcion="Inmobiliaria en Celaya. Venta y renta de propiedades en regla y sin letras chicas — Celaya, Querétaro y San Miguel de Allende. Habla directo con un asesor."
  ogImagen={config?.og_image ? assetUrl(config.og_image, 'card') : undefined}
  encabezadoSobrepuesto
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <!-- ============ HÉROE sticky: la página se desliza encima ============ -->
  <div class="relative">
    <section id="heroe" class="sticky top-0 z-0 flex min-h-svh items-end overflow-hidden bg-morado-950 pt-24">
      {
        filaSuperior.length > 0 && (
          <div id="heroe-marquee" class="absolute inset-0 flex flex-col justify-center gap-4" aria-hidden="true">
            <div class="marquee-fila" style="--marquee-duracion: 80s;">
              {[...filaSuperior, ...filaSuperior].map((p) => (
                <img
                  src={assetUrl(p.imagen_principal!, 'card')}
                  alt=""
                  width="800"
                  height="600"
                  loading="eager"
                  decoding="async"
                  class="aspect-[4/3] h-[34vh] w-auto rounded-xl object-cover sm:h-[38vh]"
                />
              ))}
            </div>
            <div class="marquee-fila marquee-invertido" style="--marquee-duracion: 95s;">
              {[...filaInferior, ...filaInferior].map((p) => (
                <img
                  src={assetUrl(p.imagen_principal!, 'card')}
                  alt=""
                  width="800"
                  height="600"
                  loading="eager"
                  decoding="async"
                  class="aspect-[4/3] h-[34vh] w-auto rounded-xl object-cover sm:h-[38vh]"
                />
              ))}
            </div>
          </div>
        )
      }

      <!-- Velo para legibilidad del texto -->
      <div class="absolute inset-0 bg-gradient-to-t from-morado-950 via-morado-950/70 to-morado-950/40" aria-hidden="true">
      </div>

      <div id="heroe-contenido" class="relative z-10 mx-auto w-full max-w-7xl px-4 pb-16 sm:px-6 sm:pb-20">
        <div class="grid items-end gap-10 lg:grid-cols-[1.4fr_auto]">
          <div class="max-w-2xl">
            <span
              data-heroe="badge"
              class="inline-block rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm text-white backdrop-blur-sm"
            >
              Inmobiliaria en Celaya
            </span>
            <h1 id="heroe-titulo" class="mt-5 text-4xl leading-tight tracking-[-0.05em] text-white sm:text-5xl lg:text-6xl">
              {tituloHero}
            </h1>
            <p data-heroe="sub" class="mt-4 max-w-xl text-lg text-white/80">{subtituloHero}</p>
            <div data-heroe="ctas" class="mt-8 flex flex-wrap items-center gap-4">
              <a href="/propiedades" class="boton-claro">Ver propiedades</a>
              <div class="flex items-center gap-3">
                <span class="hidden text-sm text-white/70 sm:inline">¿Buscas asesoría personalizada?</span>
                <a
                  href="/contacto"
                  class="inline-flex items-center gap-2 rounded-full border border-white/40 px-5 py-2.5 text-sm font-medium text-white no-underline transition-colors hover:bg-white/10"
                >
                  {ctaHero}
                </a>
              </div>
            </div>
          </div>

          <ul class="flex flex-row flex-wrap gap-3 lg:flex-col" aria-label="Por qué confiar en Morado">
            {
              ['+30 años de experiencia', 'Miembro AMPI', 'Aliados para tu crédito'].map((t) => (
                <li
                  data-heroe="chip"
                  class="flex items-center gap-2.5 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-white backdrop-blur-sm"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-dorado-400" aria-hidden="true" />
                  {t}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Velo de scroll: se oscurece y desenfoca conforme la página sube -->
      <div
        id="velo-scroll"
        class="pointer-events-none absolute inset-0 z-20"
        style="--blur: 0px; backdrop-filter: blur(var(--blur)); -webkit-backdrop-filter: blur(var(--blur)); background-color: rgba(33, 16, 54, 0);"
        aria-hidden="true"
      >
      </div>
    </section>

    <!-- ============ El resto de la página se desliza sobre el héroe ============ -->
    <div id="despues-heroe" class="relative z-10 -mt-8 overflow-hidden rounded-t-[2.5rem]">
      <!-- ENCUENTRA TU ESPACIO -->
      <section class="bg-morado-100" aria-labelledby="titulo-ciudades">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
          <h2 id="titulo-ciudades" data-animar class="text-3xl sm:text-4xl">Encuentra tu espacio</h2>
          <div data-animar-grupo class="mt-8 grid gap-5 sm:grid-cols-3">
            {
              ciudades.map((c) => (
                <a
                  href={`/propiedades?ciudad=${c.valor}`}
                  class="group relative flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-xl bg-morado-900 p-6 text-white no-underline sm:aspect-[3/4]"
                >
                  <img
                    src={c.imagen}
                    alt=""
                    width="1000"
                    height="1250"
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                  <span
                    class="absolute inset-0 bg-gradient-to-t from-morado-950/90 via-morado-950/35 to-morado-900/20 transition-colors group-hover:via-morado-950/45"
                    aria-hidden="true"
                  />
                  <span class="relative font-display text-2xl">{c.nombre}</span>
                  <span class="relative mt-1 text-sm text-white/80 transition-colors group-hover:text-white">
                    {c.lema} <span aria-hidden="true">→</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- PROPIEDADES DESTACADAS -->
      <section class="bg-morado-50" aria-labelledby="titulo-destacadas">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
          <h2 id="titulo-destacadas" data-animar class="text-3xl sm:text-4xl">Propiedades destacadas</h2>
          {
            destacadas.length > 0 ? (
              <>
                <ul data-animar-grupo class="mt-8 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
                  {destacadas.map((p, i) => (
                    <li>
                      <TarjetaPropiedad propiedad={p} prioridad={i < 3} />
                    </li>
                  ))}
                </ul>
                <div data-animar class="mt-10 text-center">
                  <a href="/propiedades" class="boton-oscuro">
                    Ver más →
                  </a>
                </div>
              </>
            ) : (
              <p class="mt-8 rounded-xl bg-white p-6 text-morado-950/70">
                Muy pronto verás aquí nuestras propiedades destacadas.
                <a href="/propiedades">Explora el catálogo completo</a>.
              </p>
            )
          }
        </div>
      </section>

      <!-- TESTIMONIOS: carrusel infinito -->
      <section class="overflow-hidden bg-white" aria-labelledby="titulo-testimonios">
        <div class="py-16 sm:py-20">
          <h2 id="titulo-testimonios" data-animar class="mx-auto max-w-7xl px-4 text-3xl sm:px-6 sm:text-4xl">
            Lo que dicen nuestros clientes
          </h2>
          <div
            data-animar
            class="marquee-borroso mt-8"
          >
            <div class="marquee-fila marquee-pausable" style="--marquee-duracion: 55s;">
              <ul class="flex list-none gap-5 p-0 pr-5">
                {
                  testimonios.map((t) => (
                    <li class="flex w-80 shrink-0 flex-col rounded-xl border border-morado-100 bg-white p-6 shadow-sm sm:w-96">
                      <span class="text-dorado-400" aria-hidden="true">
                        ★★★★★
                      </span>
                      <blockquote class="mt-3 flex-1">
                        <p class="text-morado-950/85">{t.texto}</p>
                      </blockquote>
                      <p class="mt-5 border-t border-morado-100 pt-4 text-sm font-medium text-morado-700">{t.autor}</p>
                    </li>
                  ))
                }
              </ul>
              <!-- Copia para el loop sin costura; oculta a lectores de pantalla -->
              <ul class="flex list-none gap-5 p-0 pr-5" aria-hidden="true">
                {
                  testimonios.map((t) => (
                    <li class="flex w-80 shrink-0 flex-col rounded-xl border border-morado-100 bg-white p-6 shadow-sm sm:w-96">
                      <span class="text-dorado-400">★★★★★</span>
                      <blockquote class="mt-3 flex-1">
                        <p class="text-morado-950/85">{t.texto}</p>
                      </blockquote>
                      <p class="mt-5 border-t border-morado-100 pt-4 text-sm font-medium text-morado-700">{t.autor}</p>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- NUESTRO MÉTODO -->
      <section id="metodo" class="bg-morado-950 text-white" aria-labelledby="titulo-metodo">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
          <p data-animar class="text-xs font-semibold tracking-[0.25em] text-morado-300 uppercase">Nuestro método</p>
          <h2 id="titulo-metodo" data-animar class="mt-3 max-w-3xl text-3xl leading-snug sm:text-4xl lg:text-5xl">
            Ninguna propiedad entra al portal sin pasar por el Expediente Morado.
          </h2>
          <p data-animar class="mt-4 max-w-2xl text-white/70">
            Tres revisiones antes de publicar. Por eso lo que ves aquí ya está en regla.
          </p>

          <ol data-animar-grupo class="mt-12 grid list-none gap-5 p-0 md:grid-cols-3">
            {
              pasosMetodo.map((paso, i) => (
                <li class="rounded-xl border border-morado-700 bg-morado-900 p-7">
                  <span class="flex h-9 w-9 items-center justify-center rounded-full border border-morado-500 font-display text-lg text-morado-200">
                    {i + 1}
                  </span>
                  <h3 class="mt-5 text-2xl">{paso.titulo}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-white/70">{paso.texto}</p>
                </li>
              ))
            }
          </ol>

          <p data-animar class="mt-12 text-center text-sm text-white/60">
            Asesores certificados CONOCER-SEP&ensp;·&ensp;Miembro AMPI
          </p>
        </div>
      </section>

      <!-- EQUIPO -->
      {
        asesores.length > 0 && (
          <section class="bg-morado-100" aria-labelledby="titulo-equipo">
            <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
              <div class="flex flex-wrap items-end justify-between gap-4">
                <h2 id="titulo-equipo" data-animar class="text-3xl sm:text-4xl">
                  El equipo que te acompaña
                </h2>
                <a
                  href="/asesores"
                  class="text-sm font-medium text-morado-700 no-underline hover:text-morado-950 hover:underline"
                >
                  Conoce a todo el equipo →
                </a>
              </div>
              <ul data-animar-grupo class="carril mt-8 flex list-none gap-5 overflow-x-auto p-0 pb-2">
                {asesores.map((a) => (
                  <li class="w-56 shrink-0">
                    <a href={`/asesores/${slugify(a.nombre)}`} class="group block no-underline">
                      {a.foto ? (
                        <img
                          src={assetUrl(a.foto, 'card')}
                          alt={`Fotografía de ${a.nombre}`}
                          width="448"
                          height="560"
                          loading="lazy"
                          decoding="async"
                          class="aspect-[4/5] w-full rounded-xl bg-morado-200 object-cover"
                        />
                      ) : (
                        <span class="flex aspect-[4/5] w-full items-center justify-center rounded-xl bg-morado-200 font-display text-4xl text-morado-700">
                          {a.nombre.charAt(0)}
                        </span>
                      )}
                      <span class="mt-3 block font-medium text-morado-950 group-hover:underline">{a.nombre}</span>
                      {a.puesto && <span class="block text-sm text-morado-950/60">{a.puesto}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )
      }
    </div>
  </div>
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // Todas las animaciones viven dentro de matchMedia: con
  // prefers-reduced-motion la página queda estática y completa.
  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // ---- Entrada del héroe ----
    const entrada = () => {
      const titulo = document.getElementById('heroe-titulo');
      if (!titulo) return;

      const partido = SplitText.create(titulo, { type: 'words', mask: 'words' });

      gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .from('#heroe-marquee', { opacity: 0, scale: 1.06, duration: 1.2, ease: 'power2.out' })
        .from('[data-heroe="badge"]', { y: 24, opacity: 0, duration: 0.5 }, 0.15)
        .from(partido.words, { yPercent: 110, duration: 0.7, stagger: 0.05 }, 0.3)
        .from('[data-heroe="sub"]', { y: 24, opacity: 0, duration: 0.6 }, 0.65)
        .from('[data-heroe="ctas"]', { y: 24, opacity: 0, duration: 0.6 }, 0.8)
        .from('[data-heroe="chip"]', { x: 24, opacity: 0, duration: 0.5, stagger: 0.09 }, 0.85);
    };
    // SplitText necesita las fuentes cargadas para medir bien las líneas
    document.fonts.ready.then(entrada);

    // ---- Velo de scroll: oscurece y desenfoca el héroe fijo ----
    gsap.to('#velo-scroll', {
      '--blur': '14px',
      backgroundColor: 'rgba(33, 16, 54, 0.65)',
      ease: 'none',
      scrollTrigger: {
        trigger: '#despues-heroe',
        start: 'top bottom',
        end: 'top 25%',
        scrub: true,
      },
    });

    // El contenido del héroe se aleja sutilmente al hacer scroll
    gsap.to('#heroe-contenido', {
      yPercent: -12,
      opacity: 0.3,
      ease: 'none',
      scrollTrigger: {
        trigger: '#despues-heroe',
        start: 'top bottom',
        end: 'top 25%',
        scrub: true,
      },
    });

    // ---- Reveals al hacer scroll ----
    gsap.utils.toArray<HTMLElement>('[data-animar]').forEach((el) => {
      gsap.from(el, {
        y: 32,
        opacity: 0,
        duration: 0.7,
        ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    });

    gsap.utils.toArray<HTMLElement>('[data-animar-grupo]').forEach((grupo) => {
      gsap.from(grupo.children, {
        y: 36,
        opacity: 0,
        duration: 0.7,
        ease: 'power3.out',
        stagger: 0.09,
        scrollTrigger: { trigger: grupo, start: 'top 85%' },
      });
    });
  });
</script>
