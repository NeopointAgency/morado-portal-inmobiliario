---
import Layout from '../layouts/Layout.astro';
import TarjetaPropiedad from '../components/TarjetaPropiedad.astro';
import { configuracionSitio, propiedadesDestacadas } from '../lib/queries';
import { assetUrl } from '../lib/images';
import { OPERACIONES, TIPOS, CIUDADES } from '../lib/types';
import type { Propiedad } from '../lib/types';

export const prerender = false;

const config = await configuracionSitio();

let destacadas: Propiedad[] = [];
try {
  destacadas = await propiedadesDestacadas(config);
} catch (error) {
  console.error('[home] Error al cargar destacadas', error);
}

const sitio = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;

const tituloHero = config?.hero_titular ?? 'Encuentra tu próxima casa en Celaya y la región';
const subtituloHero = config?.hero_subtitulo ?? 'Casas, departamentos y terrenos con un asesor que te acompaña de principio a fin.';
const ctaHero = config?.hero_cta_texto ?? 'Ver propiedades';

// JSON-LD RealEstateAgent para la organización
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: 'Morado Bienes Raíces',
  url: sitio,
  areaServed: 'Celaya, Guanajuato, México',
  ...(config?.telefono_general ? { telephone: config.telefono_general } : {}),
  ...(config?.email_contacto ? { email: config.email_contacto } : {}),
  ...(config?.logo ? { logo: assetUrl(config.logo, 'thumb') } : {}),
};
---

<Layout
  titulo="Morado Bienes Raíces | Casas y propiedades en venta y renta en Celaya"
  descripcion="Portal inmobiliario de Morado Bienes Raíces. Casas, departamentos, terrenos y locales en Celaya y otras plazas de Guanajuato. Habla directo con un asesor."
  ogImagen={config?.og_image ? assetUrl(config.og_image, 'card') : undefined}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <section class="heroe">
    <div class="contenedor">
      <h1>{tituloHero}</h1>
      <p>{subtituloHero}</p>

      <form class="barra-filtros" method="get" action="/propiedades" aria-label="Buscar propiedades">
        <div class="campo">
          <label for="b-operacion">Quiero</label>
          <select id="b-operacion" name="operacion">
            <option value="">Comprar o rentar</option>
            {OPERACIONES.map((o) => (
              <option value={o.valor}>{o.etiqueta}</option>
            ))}
          </select>
        </div>
        <div class="campo">
          <label for="b-tipo">Tipo</label>
          <select id="b-tipo" name="tipo">
            <option value="">Todos</option>
            {TIPOS.map((t) => (
              <option value={t.valor}>{t.etiqueta}</option>
            ))}
          </select>
        </div>
        <div class="campo">
          <label for="b-ciudad">Ciudad</label>
          <select id="b-ciudad" name="ciudad">
            <option value="">Todas</option>
            {CIUDADES.map((c) => (
              <option value={c.valor}>{c.etiqueta}</option>
            ))}
          </select>
        </div>
        <div class="campo">
          <label for="b-precio-max">Precio hasta</label>
          <input type="number" id="b-precio-max" name="precio_max" min="0" step="50000" inputmode="numeric" />
        </div>
        <button type="submit" class="boton">{ctaHero}</button>
      </form>
    </div>
  </section>

  {destacadas.length > 0 && (
    <section class="contenedor seccion" aria-labelledby="titulo-destacadas">
      <h2 id="titulo-destacadas">Propiedades destacadas</h2>
      <ul class="cuadricula-propiedades">
        {destacadas.map((p, i) => (
          <li>
            <TarjetaPropiedad propiedad={p} prioridad={i < 3} />
          </li>
        ))}
      </ul>
      <p style="margin-top: 1.5rem;">
        <a class="boton boton-secundario" href="/propiedades">Ver todas las propiedades</a>
      </p>
    </section>
  )}

  {destacadas.length === 0 && (
    <section class="contenedor seccion">
      <p class="aviso">
        Muy pronto verás aquí nuestras propiedades destacadas.
        <a href="/propiedades">Explora el catálogo completo</a>.
      </p>
    </section>
  )}
</Layout>
