---
import Layout from '../../layouts/Layout.astro';
import FormularioLead from '../../components/FormularioLead.astro';
import Icono from '../../components/Icono.astro';
import { iconoAmenidad } from '../../lib/amenidades';
import { propiedadPorSlug } from '../../lib/queries';
import { assetUrl, PRESETS } from '../../lib/images';
import { formatoPrecio, etiqueta } from '../../lib/format';
import { whatsappUrl, whatsappUrlMensaje } from '../../lib/whatsapp';
import { nombreZona, type Asesor, type GaleriaItem } from '../../lib/types';

export const prerender = false;

const { slug } = Astro.params;
const propiedad = slug
  ? await propiedadPorSlug(slug).catch((e) => {
      console.error('[ficha] Error al consultar Directus', e);
      return null;
    })
  : null;

if (!propiedad) {
  return Astro.rewrite('/404');
}

const p = propiedad;
const asesor = p.asesor && typeof p.asesor === 'object' ? (p.asesor as Asesor) : null;
const noDisponible = p.estatus === 'vendida' || p.estatus === 'rentada';

const sitio = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
const urlFicha = new URL(`/propiedades/${p.slug}`, sitio).href;

const ubicacion = [nombreZona(p.zona), p.ciudad && etiqueta(p.ciudad)].filter(Boolean).join(', ');

// SEO: campos meta con fallback generado del título y la zona
const tituloSeo = p.meta_titulo ?? `${p.titulo} | Morado Bienes Raíces`;
const descripcionSeo =
  p.meta_descripcion ??
  `${etiqueta(p.tipo)} en ${p.operacion} en ${ubicacion || 'Celaya'}. ${formatoPrecio(p.precio, p.moneda, p.operacion)}. Habla directo con el asesor.`;

const galeria: GaleriaItem[] = Array.isArray(p.galeria)
  ? (p.galeria.filter((g): g is GaleriaItem => typeof g === 'object' && g !== null) as GaleriaItem[])
  : [];

const caracteristicas: { icono: string; nombre: string; valor: string }[] = [];
if (p.recamaras) caracteristicas.push({ icono: 'cama', nombre: 'Recámaras', valor: String(p.recamaras) });
if (p.banos) caracteristicas.push({ icono: 'bano', nombre: 'Baños', valor: String(p.banos) });
if (p.estacionamientos)
  caracteristicas.push({ icono: 'auto', nombre: 'Estacionamientos', valor: String(p.estacionamientos) });
if (p.m2_terreno) caracteristicas.push({ icono: 'terreno', nombre: 'Terreno', valor: `${p.m2_terreno} m²` });
if (p.m2_construccion) caracteristicas.push({ icono: 'area', nombre: 'Construcción', valor: `${p.m2_construccion} m²` });
if (p.antiguedad) caracteristicas.push({ icono: 'antiguedad', nombre: 'Antigüedad', valor: `${p.antiguedad} años` });

const amenidades = Array.isArray(p.amenidades) ? p.amenidades : [];

// ---- Sección "Por qué con Morado": resuelve las objeciones reales del
// cliente (voz del cliente) en el contexto de ESTA propiedad. ----
const esRenta = p.operacion === 'renta';
const nombreAsesor = asesor?.nombre.split(' ')[0] ?? 'Tu asesor';

const objeciones = esRenta
  ? [
      {
        icono: 'papeles',
        objecion: '“¿Y si quien renta ni siquiera es el dueño?”',
        respuesta:
          'Antes de publicar verificamos la propiedad y a quien la ofrece. Guanajuato está entre los 5 estados con más quejas por fraude inmobiliario según PROFECO — por eso aquí nada se publica sin revisión.',
      },
      {
        icono: 'credito',
        objecion: '“Los contratos siempre traen letras chicas”',
        respuesta:
          'Contrato claro desde el día uno: renta, depósito, mantenimiento y condiciones por escrito. Lo lees completo antes de firmar, sin sorpresas.',
      },
      {
        icono: 'precio',
        objecion: '“El precio cambia cuando ya me interesé”',
        respuesta:
          'La renta publicada es la renta real, y los metros, recámaras y zona están verificados. Lo que ves es lo que hay.',
      },
      {
        icono: 'asesoria',
        objecion: '“Los asesores solo quieren cerrar rápido”',
        respuesta: `${nombreAsesor} te va a decir también lo que esta propiedad no tiene. Respuesta rápida y sin presión: preferimos que rentes bien a que rentes rápido.`,
      },
    ]
  : [
      {
        icono: 'papeles',
        objecion: '“¿Y si doy el enganche y el terreno no está regularizado?”',
        respuesta:
          'Revisamos escrituras y estado legal antes de publicar. Guanajuato está entre los 5 estados con más quejas por fraude inmobiliario según PROFECO — el miedo es real, y por eso aquí nada se publica sin expediente.',
      },
      {
        icono: 'credito',
        objecion: '“Dicen que acepta INFONAVIT y luego no es cierto”',
        respuesta:
          'Los créditos que esta propiedad acepta ya están confirmados — INFONAVIT, FOVISSSTE o bancario. Si dice que sí, es que sí; no cuando ya estás emocionado.',
      },
      {
        icono: 'precio',
        objecion: '“El precio cambia cuando ya me interesé en serio”',
        respuesta:
          'El precio publicado es el precio real, y los metros, recámaras y zona están verificados. Sin letra chica.',
      },
      {
        icono: 'asesoria',
        objecion: '“Los asesores venden lo que más comisión les deja”',
        respuesta: `${nombreAsesor} te va a decir también lo que esta propiedad no tiene. Respuesta rápida y sin presión: preferimos que compres bien a que compres rápido.`,
      },
    ];

const urlInversion = asesor
  ? whatsappUrlMensaje(
      asesor.whatsapp,
      `Hola ${nombreAsesor}, me interesa ${p.titulo} como inversión. ¿Me compartes los números de la zona? — ${urlFicha}`
    )
  : null;

// JSON-LD RealEstateListing para buscadores
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: p.titulo,
  url: urlFicha,
  ...(p.imagen_principal
    ? { image: [assetUrl(p.imagen_principal, 'hero'), ...galeria.map((g) => assetUrl(g.directus_files_id, 'galeria'))] }
    : {}),
  offers: {
    '@type': 'Offer',
    price: p.precio,
    priceCurrency: p.moneda,
    availability: noDisponible ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
  },
  address: {
    '@type': 'PostalAddress',
    ...(p.ciudad ? { addressLocality: etiqueta(p.ciudad) } : {}),
    addressRegion: 'Guanajuato',
    addressCountry: 'MX',
  },
  ...(p.recamaras ? { numberOfRooms: p.recamaras } : {}),
  ...(p.banos ? { numberOfBathroomsTotal: p.banos } : {}),
  ...(p.m2_construccion
    ? { floorSize: { '@type': 'QuantitativeValue', value: p.m2_construccion, unitCode: 'MTK' } }
    : {}),
};
---

<Layout
  titulo={tituloSeo}
  descripcion={descripcionSeo}
  ogImagen={p.imagen_principal ? assetUrl(p.imagen_principal, 'card') : undefined}
  ogTipo="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <nav aria-label="Ruta de navegación" class="mb-5 text-sm">
      <a href="/propiedades" class="text-morado-700 no-underline hover:underline">← Ver propiedades</a>
    </nav>

    <div class="grid gap-10 lg:grid-cols-[1.8fr_1fr] lg:items-start">
      <article>
        {
          p.imagen_principal && (
            <div class="relative">
              <a
                href={assetUrl(p.imagen_principal, 'galeria')}
                class="js-lightbox block cursor-zoom-in"
                data-alt={`Fotografía principal de ${p.titulo}`}
                aria-label={`Ver fotografía principal de ${p.titulo} en grande`}
              >
                <img
                  src={assetUrl(p.imagen_principal, 'hero')}
                  alt={`Fotografía principal de ${p.titulo}`}
                  width={PRESETS.hero.width}
                  height={PRESETS.hero.height}
                  loading="eager"
                  fetchpriority="high"
                  class="aspect-[16/10] w-full rounded-xl bg-morado-100 object-cover"
                />
              </a>
              {galeria.length > 0 && (
                <div class="absolute right-3 bottom-3 flex gap-2" aria-label="Más fotografías de esta propiedad">
                  {galeria.slice(0, 3).map((g, i) => (
                    <button
                      type="button"
                      class="js-lightbox-salto relative block cursor-zoom-in overflow-hidden rounded-lg border-2 border-white/90 shadow-lg transition-transform hover:scale-105"
                      data-indice={i + 1}
                      aria-label={`Ver fotografía ${i + 2} de ${p.titulo}`}
                    >
                      <img
                        src={assetUrl(g.directus_files_id, 'thumb')}
                        alt=""
                        width="80"
                        height="56"
                        loading="eager"
                        decoding="async"
                        class="h-12 w-16 object-cover sm:h-14 sm:w-20"
                      />
                      {i === 2 && galeria.length > 3 && (
                        <span class="absolute inset-0 flex items-center justify-center bg-morado-950/60 text-sm font-semibold text-white">
                          +{galeria.length - 3}
                        </span>
                      )}
                    </button>
                  ))}
                </div>
              )}
            </div>
          )
        }

        <header class="mt-6">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <p class="text-sm font-medium tracking-wide text-morado-700 uppercase">
              {p.operacion === 'venta' ? 'En venta' : 'En renta'} · {etiqueta(p.tipo)}
              {p.estatus === 'apartada' && ' · Apartada'}
            </p>
            <button
              type="button"
              id="boton-compartir"
              data-titulo={p.titulo}
              data-url={urlFicha}
              class="flex items-center gap-2 rounded-full border border-morado-200 px-4 py-1.5 text-sm font-medium text-morado-950 transition-colors hover:border-morado-600 hover:bg-morado-50"
            >
              <Icono nombre="compartir" clase="h-4 w-4 text-morado-600" />
              <span id="boton-compartir-texto">Compartir</span>
            </button>
          </div>
          <h1 class="mt-1 text-3xl sm:text-4xl">{p.titulo}</h1>
          {ubicacion && <p class="mt-1 text-morado-950/60">{ubicacion}</p>}
          {p.mostrar_direccion_exacta && p.direccion && <p class="text-morado-950/60">{p.direccion}</p>}
          <p class="mt-3 text-3xl font-semibold tracking-tight">{formatoPrecio(p.precio, p.moneda, p.operacion)}</p>
        </header>

        {
          noDisponible && (
            <p class="mt-6 rounded-xl bg-morado-100 p-5 text-morado-950/80" role="status">
              Esta propiedad ya se {p.estatus === 'vendida' ? 'vendió' : 'rentó'}.
              <a href="/propiedades" class="font-medium text-morado-700">
                Mira otras propiedades disponibles
              </a>
              .
            </p>
          )
        }

        {
          caracteristicas.length > 0 && (
            <section class="mt-10">
              <h2 class="text-2xl">Características</h2>
              <ul class="mt-4 grid list-none grid-cols-2 gap-x-6 gap-y-3 p-0 sm:grid-cols-3">
                {caracteristicas.map((c) => (
                  <li class="flex items-center gap-3 rounded-lg bg-morado-50 px-4 py-3">
                    <Icono nombre={c.icono} clase="h-5 w-5 text-morado-600" />
                    <span>
                      <span class="block text-xs text-morado-950/50 uppercase">{c.nombre}</span>
                      <span class="font-medium">{c.valor}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          amenidades.length > 0 && (
            <section class="mt-10">
              <h2 class="text-2xl">Amenidades</h2>
              <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
                {amenidades.map((a) => (
                  <li class="flex items-center gap-2 rounded-full bg-morado-100 px-4 py-1.5 text-sm">
                    <Icono nombre={iconoAmenidad(a)} clase="h-4 w-4 text-morado-600" />
                    {a}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          p.descripcion && (
            <section class="mt-10">
              <h2 class="text-2xl">Acerca de esta propiedad</h2>
              <div class="prose-morado mt-4 max-w-none leading-relaxed text-morado-950/80" set:html={p.descripcion} />
            </section>
          )
        }

        {
          p.video_url && (
            <section class="mt-10">
              <h2 class="text-2xl">Video</h2>
              <p class="mt-3">
                <a href={p.video_url} target="_blank" rel="noopener" class="boton-borde">
                  Ver video de la propiedad
                </a>
              </p>
            </section>
          )
        }

        {
          galeria.length > 0 && (
            <section class="mt-10">
              <h2 class="text-2xl">Galería</h2>
              <ul class="mt-4 grid list-none gap-4 p-0 sm:grid-cols-2">
                {galeria.map((g, i) => (
                  <li>
                    <a
                      href={assetUrl(g.directus_files_id, 'galeria')}
                      class="js-lightbox block cursor-zoom-in overflow-hidden rounded-xl"
                      data-alt={`Fotografía ${i + 2} de ${p.titulo}`}
                      aria-label={`Ver fotografía ${i + 2} de ${p.titulo} en grande`}
                    >
                      <img
                        src={assetUrl(g.directus_files_id, 'galeria')}
                        alt={`Fotografía ${i + 2} de ${p.titulo}`}
                        width={PRESETS.galeria.width}
                        height={PRESETS.galeria.height}
                        loading="lazy"
                        decoding="async"
                        class="w-full bg-morado-100 object-cover transition-transform duration-300 hover:scale-[1.02]"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </article>

      <aside class="rounded-xl bg-white p-6 shadow-lg ring-1 ring-morado-950/5 lg:sticky lg:top-6">
        {
          asesor ? (
            <>
              <div class="flex items-center gap-4">
                {asesor.foto && (
                  <img
                    src={assetUrl(asesor.foto, 'galeria')}
                    alt={`Fotografía de ${asesor.nombre}`}
                    width="64"
                    height="64"
                    loading="lazy"
                    class="h-16 w-16 rounded-full object-cover object-top"
                  />
                )}
                <div>
                  <p class="font-medium">{asesor.nombre}</p>
                  {asesor.puesto && <p class="text-sm text-morado-950/60">{asesor.puesto}</p>}
                </div>
              </div>
              {!noDisponible && (
                <>
                  <a class="boton-oscuro mt-5 w-full" href={whatsappUrl(asesor.whatsapp, p.titulo, urlFicha)}>
                    <Icono nombre="whatsapp" clase="h-4.5 w-4.5 text-whatsapp" />
                    Enviar WhatsApp
                  </a>
                  <p class="my-4 text-center text-sm text-morado-950/50">o déjanos tus datos:</p>
                  <FormularioLead propiedadId={p.id} origen="ficha" />
                </>
              )}
            </>
          ) : (
            <>
              <p class="font-medium">¿Te interesa esta propiedad?</p>
              {!noDisponible && (
                <div class="mt-4">
                  <FormularioLead propiedadId={p.id} origen="ficha" />
                </div>
              )}
            </>
          )
        }
      </aside>
    </div>
  </div>

  <!-- Barra fija móvil: el camino a WhatsApp siempre a un toque -->
  {
    asesor && !noDisponible && (
      <div
        class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-between gap-4 border-t border-morado-950/10 bg-white/95 px-4 py-3 backdrop-blur-sm lg:hidden"
        style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
      >
        <div class="min-w-0">
          <p class="truncate text-lg leading-tight font-semibold">{formatoPrecio(p.precio, p.moneda, p.operacion)}</p>
          <p class="truncate text-xs text-morado-950/60">Te atiende {asesor.nombre.split(' ')[0]}</p>
        </div>
        <a href={whatsappUrl(asesor.whatsapp, p.titulo, urlFicha)} class="boton-oscuro shrink-0 px-5 py-2.5 text-sm">
          <Icono nombre="whatsapp" clase="h-4 w-4 text-whatsapp" />
          Enviar WhatsApp
        </a>
      </div>
    )
  }

  <!-- ============ POR QUÉ CON MORADO: objeciones resueltas ============ -->
  <section class="mt-16 bg-morado-950 text-white" aria-labelledby="titulo-morado">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="text-xs font-semibold tracking-[0.25em] text-morado-300 uppercase">Por qué con Morado</p>
      <h2 id="titulo-morado" class="mt-3 max-w-3xl text-3xl leading-snug sm:text-4xl">
        {esRenta ? 'Réntala tranquilo: lo que te preocupa, ya lo resolvimos.' : 'Enamórate tranquilo: lo que te preocupa, ya lo resolvimos.'}
      </h2>
      <p class="mt-4 max-w-2xl text-white/70">
        Sabemos lo que se siente {esRenta ? 'rentar' : 'comprar'} — porque estas dudas las hemos escuchado cientos de
        veces. Esto es lo que Morado ya revisó por ti en esta propiedad:
      </p>

      <ul class="mt-10 grid list-none gap-5 p-0 md:grid-cols-2">
        {
          objeciones.map((o) => (
            <li class="rounded-xl border border-morado-700 bg-morado-900 p-7">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-morado-500">
                  <Icono nombre={o.icono} clase="h-5 w-5 text-morado-200" />
                </span>
                <h3 class="font-sans text-base font-semibold text-morado-100">{o.objecion}</h3>
              </div>
              <p class="mt-4 text-sm leading-relaxed text-white/75">{o.respuesta}</p>
            </li>
          ))
        }
      </ul>

      {
        !esRenta && urlInversion && (
          <div class="mt-8 flex flex-wrap items-center justify-between gap-6 rounded-xl border border-morado-700 bg-gradient-to-r from-morado-900 to-morado-800 p-7">
            <div class="flex items-start gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-morado-500">
                <Icono nombre="inversion" clase="h-5 w-5 text-morado-200" />
              </span>
              <div class="max-w-xl">
                <h3 class="font-sans text-base font-semibold text-morado-100">¿La ves como inversión?</h3>
                <p class="mt-2 text-sm leading-relaxed text-white/75">
                  Hablemos de cifras, no de sueños. Un inmueble bien elegido en México rinde entre 6% y 12% anual — el
                  número exacto de esta zona (demanda real de renta, meses vacíos, mantenimiento) te lo da{' '}
                  {nombreAsesor} con datos.
                </p>
              </div>
            </div>
            <a href={urlInversion} class="boton-claro shrink-0">
              Pedir los números de la zona
            </a>
          </div>
        )
      }

      <p class="mt-10 text-center text-sm text-white/60">
        Asesores certificados CONOCER-SEP&ensp;·&ensp;Miembro AMPI&ensp;·&ensp;+30 años de experiencia
      </p>
    </div>
    <!-- Colchón para que la barra fija móvil no tape el final de la página -->
    <div class="h-20 lg:hidden" aria-hidden="true"></div>
  </section>

  <!-- Lightbox de la galería: <dialog> nativo (Esc y foco atrapado gratis) -->
  <dialog
    id="lightbox"
    class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-morado-950/90 backdrop:backdrop-blur-md"
    aria-label={`Galería de ${p.titulo}`}
  >
    <div class="flex h-svh w-svw flex-col items-center justify-center gap-4 p-4" id="lightbox-marco">
      <img id="lightbox-img" src="" alt="" class="max-h-[80svh] max-w-[92svw] rounded-xl object-contain" />
      <div class="flex items-center gap-4">
        <button
          type="button"
          id="lightbox-prev"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-white/30 text-xl text-white transition-colors hover:bg-white/10"
          aria-label="Fotografía anterior"
        >
          ←
        </button>
        <span id="lightbox-contador" class="min-w-16 text-center text-sm text-white/80" aria-live="polite"></span>
        <button
          type="button"
          id="lightbox-next"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-white/30 text-xl text-white transition-colors hover:bg-white/10"
          aria-label="Fotografía siguiente"
        >
          →
        </button>
        <button
          type="button"
          id="lightbox-cerrar"
          class="ml-4 flex h-11 items-center justify-center rounded-full border border-white/30 px-5 text-sm text-white transition-colors hover:bg-white/10"
        >
          Cerrar
        </button>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  const dialogo = document.getElementById('lightbox') as HTMLDialogElement | null;
  const imagen = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const contador = document.getElementById('lightbox-contador');
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('.js-lightbox')];

  if (dialogo && imagen && contador && enlaces.length > 0) {
    let indice = 0;

    const mostrar = (i: number) => {
      indice = (i + enlaces.length) % enlaces.length;
      imagen.src = enlaces[indice].href;
      imagen.alt = enlaces[indice].dataset.alt ?? '';
      contador.textContent = `${indice + 1} / ${enlaces.length}`;
      // Precargar vecinas para que prev/next se sientan instantáneos
      for (const v of [indice + 1, indice - 1]) {
        new Image().src = enlaces[(v + enlaces.length) % enlaces.length].href;
      }
    };

    enlaces.forEach((enlace, i) => {
      enlace.addEventListener('click', (e) => {
        e.preventDefault();
        mostrar(i);
        dialogo.showModal();
      });
    });

    // Miniaturas en la esquina de la imagen principal: saltan directo a esa foto
    document.querySelectorAll<HTMLButtonElement>('.js-lightbox-salto').forEach((boton) => {
      boton.addEventListener('click', () => {
        mostrar(Number(boton.dataset.indice ?? 0));
        dialogo.showModal();
      });
    });

    document.getElementById('lightbox-prev')?.addEventListener('click', () => mostrar(indice - 1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => mostrar(indice + 1));
    document.getElementById('lightbox-cerrar')?.addEventListener('click', () => dialogo.close());

    dialogo.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostrar(indice - 1);
      if (e.key === 'ArrowRight') mostrar(indice + 1);
    });

    // Clic fuera de la imagen (en el fondo) cierra
    dialogo.addEventListener('click', (e) => {
      if (e.target === dialogo || e.target === document.getElementById('lightbox-marco')) dialogo.close();
    });

    // Swipe horizontal en táctil para navegar
    let inicioX = 0;
    dialogo.addEventListener('pointerdown', (e) => (inicioX = e.clientX));
    dialogo.addEventListener('pointerup', (e) => {
      const delta = e.clientX - inicioX;
      if (Math.abs(delta) > 48) mostrar(delta > 0 ? indice - 1 : indice + 1);
    });
  }

  // ---- Compartir: hoja nativa del sistema; si no hay, copia el enlace ----
  const botonCompartir = document.getElementById('boton-compartir');
  const textoCompartir = document.getElementById('boton-compartir-texto');
  botonCompartir?.addEventListener('click', async () => {
    const titulo = botonCompartir.dataset.titulo ?? document.title;
    const url = botonCompartir.dataset.url ?? location.href;
    try {
      if (navigator.share) {
        await navigator.share({ title: titulo, text: `Mira esta propiedad: ${titulo}`, url });
      } else {
        await navigator.clipboard.writeText(url);
        if (textoCompartir) {
          textoCompartir.textContent = 'Enlace copiado';
          setTimeout(() => (textoCompartir.textContent = 'Compartir'), 2000);
        }
      }
    } catch {
      /* el usuario canceló la hoja de compartir: no es un error */
    }
  });
</script>
