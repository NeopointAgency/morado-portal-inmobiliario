---
import Layout from '../../layouts/Layout.astro';
import FormularioLead from '../../components/FormularioLead.astro';
import { propiedadPorSlug } from '../../lib/queries';
import { assetUrl, PRESETS } from '../../lib/images';
import { formatoPrecio, etiqueta } from '../../lib/format';
import { whatsappUrl } from '../../lib/whatsapp';
import type { Asesor, GaleriaItem } from '../../lib/types';

export const prerender = false;

const { slug } = Astro.params;
const propiedad = slug
  ? await propiedadPorSlug(slug).catch((e) => {
      console.error('[ficha] Error al consultar Directus', e);
      return null;
    })
  : null;

if (!propiedad) {
  return Astro.rewrite('/404');
}

const p = propiedad;
const asesor = p.asesor && typeof p.asesor === 'object' ? (p.asesor as Asesor) : null;
const noDisponible = p.estatus === 'vendida' || p.estatus === 'rentada';

const sitio = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
const urlFicha = new URL(`/propiedades/${p.slug}`, sitio).href;

const ubicacion = [p.zona && etiqueta(p.zona), p.ciudad && etiqueta(p.ciudad)].filter(Boolean).join(', ');

// SEO: campos meta con fallback generado del título y la zona
const tituloSeo = p.meta_titulo ?? `${p.titulo} | Morado Bienes Raíces`;
const descripcionSeo =
  p.meta_descripcion ??
  `${etiqueta(p.tipo)} en ${p.operacion} en ${ubicacion || 'Celaya'}. ${formatoPrecio(p.precio, p.moneda, p.operacion)}. Habla directo con el asesor.`;

const galeria: GaleriaItem[] = Array.isArray(p.galeria)
  ? (p.galeria.filter((g): g is GaleriaItem => typeof g === 'object' && g !== null) as GaleriaItem[])
  : [];

const caracteristicas: [string, string][] = [];
if (p.recamaras) caracteristicas.push(['Recámaras', String(p.recamaras)]);
if (p.banos) caracteristicas.push(['Baños', String(p.banos)]);
if (p.estacionamientos) caracteristicas.push(['Estacionamientos', String(p.estacionamientos)]);
if (p.m2_terreno) caracteristicas.push(['Terreno', `${p.m2_terreno} m²`]);
if (p.m2_construccion) caracteristicas.push(['Construcción', `${p.m2_construccion} m²`]);
if (p.antiguedad) caracteristicas.push(['Antigüedad', `${p.antiguedad} años`]);

const amenidades = Array.isArray(p.amenidades) ? p.amenidades : [];

// JSON-LD RealEstateListing para buscadores
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: p.titulo,
  url: urlFicha,
  ...(p.imagen_principal
    ? { image: [assetUrl(p.imagen_principal, 'hero'), ...galeria.map((g) => assetUrl(g.directus_files_id, 'galeria'))] }
    : {}),
  offers: {
    '@type': 'Offer',
    price: p.precio,
    priceCurrency: p.moneda,
    availability: noDisponible ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
  },
  address: {
    '@type': 'PostalAddress',
    ...(p.ciudad ? { addressLocality: etiqueta(p.ciudad) } : {}),
    addressRegion: 'Guanajuato',
    addressCountry: 'MX',
  },
  ...(p.recamaras ? { numberOfRooms: p.recamaras } : {}),
  ...(p.banos ? { numberOfBathroomsTotal: p.banos } : {}),
  ...(p.m2_construccion
    ? { floorSize: { '@type': 'QuantitativeValue', value: p.m2_construccion, unitCode: 'MTK' } }
    : {}),
};
---

<Layout
  titulo={tituloSeo}
  descripcion={descripcionSeo}
  ogImagen={p.imagen_principal ? assetUrl(p.imagen_principal, 'card') : undefined}
  ogTipo="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <nav aria-label="Ruta de navegación" class="mb-5 text-sm">
      <a href="/propiedades" class="text-morado-700 no-underline hover:underline">← Ver propiedades</a>
    </nav>

    <div class="grid gap-10 lg:grid-cols-[1.8fr_1fr] lg:items-start">
      <article>
        {
          p.imagen_principal && (
            <img
              src={assetUrl(p.imagen_principal, 'hero')}
              alt={`Fotografía principal de ${p.titulo}`}
              width={PRESETS.hero.width}
              height={PRESETS.hero.height}
              loading="eager"
              fetchpriority="high"
              class="aspect-[16/10] w-full rounded-xl bg-morado-100 object-cover"
            />
          )
        }

        <header class="mt-6">
          <p class="text-sm font-medium tracking-wide text-morado-700 uppercase">
            {p.operacion === 'venta' ? 'En venta' : 'En renta'} · {etiqueta(p.tipo)}
            {p.estatus === 'apartada' && ' · Apartada'}
          </p>
          <h1 class="mt-1 text-3xl sm:text-4xl">{p.titulo}</h1>
          {ubicacion && <p class="mt-1 text-morado-950/60">{ubicacion}</p>}
          {p.mostrar_direccion_exacta && p.direccion && <p class="text-morado-950/60">{p.direccion}</p>}
          <p class="mt-3 text-3xl font-semibold tracking-tight">{formatoPrecio(p.precio, p.moneda, p.operacion)}</p>
        </header>

        {
          noDisponible && (
            <p class="mt-6 rounded-xl bg-morado-100 p-5 text-morado-950/80" role="status">
              Esta propiedad ya se {p.estatus === 'vendida' ? 'vendió' : 'rentó'}.
              <a href="/propiedades" class="font-medium text-morado-700">
                Mira otras propiedades disponibles
              </a>
              .
            </p>
          )
        }

        {
          caracteristicas.length > 0 && (
            <section class="mt-10">
              <h2 class="text-2xl">Características</h2>
              <ul class="mt-4 grid list-none grid-cols-2 gap-x-6 gap-y-3 p-0 sm:grid-cols-3">
                {caracteristicas.map(([nombre, valor]) => (
                  <li class="rounded-lg bg-morado-50 px-4 py-3">
                    <span class="block text-xs text-morado-950/50 uppercase">{nombre}</span>
                    <span class="font-medium">{valor}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          amenidades.length > 0 && (
            <section class="mt-10">
              <h2 class="text-2xl">Amenidades</h2>
              <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
                {amenidades.map((a) => (
                  <li class="rounded-full bg-morado-100 px-4 py-1.5 text-sm">{a}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          p.descripcion && (
            <section class="mt-10">
              <h2 class="text-2xl">Acerca de esta propiedad</h2>
              <div class="prose-morado mt-4 max-w-none leading-relaxed text-morado-950/80" set:html={p.descripcion} />
            </section>
          )
        }

        {
          p.video_url && (
            <section class="mt-10">
              <h2 class="text-2xl">Video</h2>
              <p class="mt-3">
                <a href={p.video_url} target="_blank" rel="noopener" class="boton-borde">
                  Ver video de la propiedad
                </a>
              </p>
            </section>
          )
        }

        {
          galeria.length > 0 && (
            <section class="mt-10">
              <h2 class="text-2xl">Galería</h2>
              <ul class="mt-4 grid list-none gap-4 p-0 sm:grid-cols-2">
                {galeria.map((g, i) => (
                  <li>
                    <img
                      src={assetUrl(g.directus_files_id, 'galeria')}
                      alt={`Fotografía ${i + 2} de ${p.titulo}`}
                      width={PRESETS.galeria.width}
                      height={PRESETS.galeria.height}
                      loading="lazy"
                      decoding="async"
                      class="w-full rounded-xl bg-morado-100 object-cover"
                    />
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </article>

      <aside class="rounded-xl bg-white p-6 shadow-lg ring-1 ring-morado-950/5 lg:sticky lg:top-6">
        {
          asesor ? (
            <>
              <div class="flex items-center gap-4">
                {asesor.foto && (
                  <img
                    src={assetUrl(asesor.foto, 'thumb')}
                    alt={`Fotografía de ${asesor.nombre}`}
                    width="64"
                    height="64"
                    loading="lazy"
                    class="h-16 w-16 rounded-full object-cover"
                  />
                )}
                <div>
                  <p class="font-medium">{asesor.nombre}</p>
                  {asesor.puesto && <p class="text-sm text-morado-950/60">{asesor.puesto}</p>}
                </div>
              </div>
              {!noDisponible && (
                <>
                  <a class="boton-oscuro mt-5 w-full" href={whatsappUrl(asesor.whatsapp, p.titulo, urlFicha)}>
                    Enviar WhatsApp
                  </a>
                  <p class="my-4 text-center text-sm text-morado-950/50">o déjanos tus datos:</p>
                  <FormularioLead propiedadId={p.id} origen="ficha" />
                </>
              )}
            </>
          ) : (
            <>
              <p class="font-medium">¿Te interesa esta propiedad?</p>
              {!noDisponible && (
                <div class="mt-4">
                  <FormularioLead propiedadId={p.id} origen="ficha" />
                </div>
              )}
            </>
          )
        }
      </aside>
    </div>
  </div>
</Layout>
