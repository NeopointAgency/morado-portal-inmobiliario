---
import Layout from '../../layouts/Layout.astro';
import TarjetaPropiedad from '../../components/TarjetaPropiedad.astro';
import Paginacion from '../../components/Paginacion.astro';
import { buscarPropiedades, filtrosDesdeParams } from '../../lib/queries';
import { OPERACIONES, TIPOS, CIUDADES } from '../../lib/types';
import type { ResultadoBusqueda } from '../../lib/queries';

export const prerender = false;

const params = Astro.url.searchParams;
const filtros = filtrosDesdeParams(params);

// Query params → filtro de Directus, siempre del lado del servidor.
let resultado: ResultadoBusqueda | null = null;
let errorCarga = false;
try {
  resultado = await buscarPropiedades(filtros);
} catch (error) {
  console.error('[propiedades] Error al consultar Directus', error);
  errorCarga = true;
}

const titulo = 'Propiedades en venta y renta | Morado Bienes Raíces';
const descripcion =
  'Casas, departamentos, terrenos y locales en Celaya, Querétaro y San Miguel de Allende. Encuentra tu propiedad y habla directo con el asesor.';

const claseLabel = 'mb-1 block text-sm font-medium';
---

<Layout titulo={titulo} descripcion={descripcion}>
  <div class="bg-morado-950 text-white">
    <div class="mx-auto max-w-7xl px-4 pt-10 pb-12 sm:px-6">
      <h1 class="text-4xl sm:text-5xl">Propiedades</h1>
      <p class="mt-2 text-white/70">Todo lo que ves aquí ya pasó por el Expediente Morado: en regla y sin letras chicas.</p>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 pb-16 sm:px-6">
    <form
      class="relative z-10 -mt-6 grid grid-cols-2 items-end gap-3 rounded-xl bg-white p-4 shadow-lg ring-1 ring-morado-950/5 sm:gap-4 sm:p-5 lg:grid-cols-7"
      method="get"
      action="/propiedades"
    >
      <div>
        <label for="f-operacion" class={claseLabel}>Quiero</label>
        <select id="f-operacion" name="operacion" class="campo-input">
          <option value="">Comprar o rentar</option>
          {OPERACIONES.map((o) => (
            <option value={o.valor} selected={filtros.operacion === o.valor}>
              {o.etiqueta}
            </option>
          ))}
        </select>
      </div>

      <div>
        <label for="f-tipo" class={claseLabel}>Tipo</label>
        <select id="f-tipo" name="tipo" class="campo-input">
          <option value="">Todos</option>
          {TIPOS.map((t) => (
            <option value={t.valor} selected={filtros.tipo === t.valor}>
              {t.etiqueta}
            </option>
          ))}
        </select>
      </div>

      <div>
        <label for="f-ciudad" class={claseLabel}>Ciudad</label>
        <select id="f-ciudad" name="ciudad" class="campo-input">
          <option value="">Todas</option>
          {CIUDADES.map((c) => (
            <option value={c.valor} selected={filtros.ciudad === c.valor}>
              {c.etiqueta}
            </option>
          ))}
        </select>
      </div>

      <div>
        <label for="f-recamaras" class={claseLabel}>Recámaras</label>
        <select id="f-recamaras" name="recamaras" class="campo-input">
          <option value="">Cualquiera</option>
          {[1, 2, 3, 4].map((n) => (
            <option value={String(n)} selected={filtros.recamaras === n}>
              {n}+
            </option>
          ))}
        </select>
      </div>

      <div>
        <label for="f-precio-min" class={claseLabel}>Precio desde</label>
        <input
          type="number"
          id="f-precio-min"
          name="precio_min"
          min="0"
          step="50000"
          inputmode="numeric"
          value={filtros.precio_min ?? ''}
          class="campo-input"
        />
      </div>

      <div>
        <label for="f-precio-max" class={claseLabel}>Precio hasta</label>
        <input
          type="number"
          id="f-precio-max"
          name="precio_max"
          min="0"
          step="50000"
          inputmode="numeric"
          value={filtros.precio_max ?? ''}
          class="campo-input"
        />
      </div>

      <button type="submit" class="boton-oscuro col-span-2 lg:col-span-1">Buscar</button>
    </form>

    <div class="mt-10">
      {
        errorCarga && (
          <p class="rounded-xl bg-morado-100 p-6 text-morado-950/80" role="alert">
            No pudimos cargar las propiedades en este momento. Intenta de nuevo en unos minutos.
          </p>
        )
      }

      {
        resultado && resultado.items.length === 0 && (
          <div class="rounded-xl bg-morado-100 p-6 text-morado-950/80">
            <p>No encontramos propiedades con esos filtros.</p>
            <p class="mt-2">
              <a href="/propiedades" class="font-medium text-morado-700">
                Ver todas las propiedades
              </a>
            </p>
          </div>
        )
      }

      {
        resultado && resultado.items.length > 0 && (
          <>
            <p class="text-sm text-morado-950/60">
              {resultado.total} {resultado.total === 1 ? 'propiedad' : 'propiedades'}
            </p>
            <ul class="mt-4 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
              {resultado.items.map((p, i) => (
                <li>
                  <TarjetaPropiedad propiedad={p} prioridad={i < 3 && filtros.pagina === 1} />
                </li>
              ))}
            </ul>
            <Paginacion pagina={resultado.pagina} totalPaginas={resultado.totalPaginas} params={params} ruta="/propiedades" />
          </>
        )
      }
    </div>
  </div>
</Layout>
